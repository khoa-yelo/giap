{#- Bioconda recipe for GIPPA (M11-10), rendered by scripts/release/bioconda_recipe.py.
    Channels: conda-forge and bioconda only (spec §3.2). Values are quoted so the rendered file
    parses with PyYAML as strings; conda-build substitutes the PYTHON variable itself. -#}
package:
  name: gippa
  version: "{{ version }}"

source:
  url: https://pypi.org/packages/source/g/gippa/gippa-{{ version }}.tar.gz
  sha256: "{{ sha256 }}"

build:
  noarch: python
  number: 0
  script: "{{ '{{' }} PYTHON {{ '}}' }} -m pip install . --no-deps --no-build-isolation -vv"
  entry_points:
    - gippa = gippa.cli:main
  # bioconda-utils lint missing_run_exports: new recipes pin their own subpackage (lead, #345 B1).
  run_exports:
    - '{{ '{{' }} pin_subpackage("gippa", max_pin="x") {{ '}}' }}'

requirements:
  host:
    - python >=3.11
    - pip
    - hatchling
  run:
    - python >=3.11
    # Rendered from [project].dependencies; codon-bias is bioconda-only (no conda-forge package).
{%- for dep in run %}
    - {{ dep }}
{%- endfor %}
    # Q-L10: gippa run needs Nextflow and a JVM.
    - nextflow >=25.04
    - openjdk >=17

test:
  requires:
    - pip
  imports:
    - gippa
    - gippa.cli
  commands:
    - gippa --version
    - gippa --help
    - pip check

about:
  home: https://github.com/khoa-yelo/gippa
  license: MIT
  license_file: LICENSE
  summary: "{{ summary }}"
  doc_url: https://khoa-yelo.github.io/gippa/
  dev_url: https://github.com/khoa-yelo/gippa

extra:
  recipe-maintainers:
    - khoa-yelo
{%- if doi %}
  identifiers:
    - doi:{{ doi }}
{%- endif %}
