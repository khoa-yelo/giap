{
  "name": "detection_summary",
  "description": "Detection summary in long format: tier, basic O - E, detectability and QC rows (GIAP_SPEC.md §9.3).",
  "missingValues": ["NA", ""],
  "fields": [
    {"name": "section", "type": "string", "description": "Summary section", "constraints": {"required": true, "enum": ["tier", "basic", "detectability", "qc"]}},
    {"name": "group_type", "type": "string", "description": "Grouping kind (e.g. replicon, feature_class, cog_category, run)", "constraints": {"required": true}},
    {"name": "group", "type": "string", "description": "Group label", "constraints": {"required": true}},
    {"name": "metric", "type": "string", "description": "Metric name (units in the name, §9.2)", "constraints": {"required": true}},
    {"name": "value", "type": "number", "description": "Metric value"},
    {"name": "ci_low", "type": "number", "description": "Lower 95 % CI bound"},
    {"name": "ci_high", "type": "number", "description": "Upper 95 % CI bound"},
    {"name": "n", "type": "integer", "description": "Number of units behind the metric", "constraints": {"minimum": 0}},
    {"name": "flags", "type": "string", "description": "Semicolon-joined flags"}
  ]
}
