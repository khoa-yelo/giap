{
  "name": "peptide_hits",
  "description": "One row per peptide x accepted locus (GIAP_SPEC.md §9.3); rejected placements are in unmapped.tsv.",
  "coordinates": "1-based-closed",
  "missingValues": ["NA", ""],
  "fields": [
    {"name": "peptide", "type": "string", "description": "Peptide sequence as written in the input (I/L kept)", "constraints": {"required": true}},
    {"name": "peptide_len", "type": "integer", "description": "Peptide length (aa)", "constraints": {"required": true}},
    {"name": "source", "type": "string", "description": "Peptide source (database or denovo)"},
    {"name": "best_q_input", "type": "number", "description": "Best engine q-value of the input PSMs"},
    {"name": "pep_input", "type": "number", "description": "Engine posterior error probability"},
    {"name": "score_input", "type": "number", "description": "Engine score"},
    {"name": "contig", "type": "string", "description": "Replicon ID", "constraints": {"required": true}},
    {"name": "start", "type": "integer", "description": "Start, 1-based closed", "constraints": {"required": true}},
    {"name": "end", "type": "integer", "description": "End, 1-based closed; > replicon length for origin-crossing hits", "constraints": {"required": true}},
    {"name": "strand", "type": "string", "description": "Strand", "constraints": {"required": true, "enum": ["+", "-"]}},
    {"name": "frame", "type": "integer", "description": "Reading frame (+1..+3, -1..-3)"},
    {"name": "crosses_origin", "type": "boolean", "description": "Hit crosses the origin of a circular replicon"},
    {"name": "route", "type": "string", "description": "Mapping route", "constraints": {"required": true, "enum": ["exact", "tolerant"]}},
    {"name": "n_diff", "type": "integer", "description": "Number of differences to the genome"},
    {"name": "diff_types", "type": "string", "description": "Difference types (';'-separated list)"},
    {"name": "placement_q", "type": "number", "description": "Placement q-value"},
    {"name": "length_class", "type": "string", "description": "Peptide length class of the placement FDR stratum"},
    {"name": "locus_class", "type": "string", "description": "Locus class (§9.4, ADR-0013)", "constraints": {"enum": ["rna_overlap", "pseudogene", "sorf", "cds_inframe", "nterm_extension", "cterm_extension", "cds_outframe", "antisense", "intergenic"]}},
    {"name": "uniqueness", "type": "string", "description": "Uniqueness of the placement", "constraints": {"enum": ["unique", "multi_identical", "shared"]}},
    {"name": "gene", "type": "string", "description": "Assigned gene locus tag"},
    {"name": "novel_candidate_id", "type": "string", "description": "Novel candidate ID"},
    {"name": "flags", "type": "string", "description": "Flags (';'-separated list; §9.4 Placement, including readthrough: the row consumed an annotated terminal stop; sec_site / pyl_site: it consumed an annotated recoded Sec (TGA) / Pyl (TAG) codon, M7-16)", "constraints": {"pattern": "(?:engine_protein_mismatch|low_complexity|multi|multi_identical|nterm_extension_evidence|origin_spanning|pyl_site|readthrough|same_db|sec_site|strain_difference)(?:;(?:engine_protein_mismatch|low_complexity|multi|multi_identical|nterm_extension_evidence|origin_spanning|pyl_site|readthrough|same_db|sec_site|strain_difference))*"}}
  ]
}
