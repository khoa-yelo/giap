{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khoa-yelo/gippa/schemas/run_manifest.schema.json",
  "title": "GIPPA run manifest",
  "description": "run_manifest.json written by every gippa run past preflight (GIPPA_SPEC.md section 6.7; MVP-03 D-C; ADR-0040).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "output_schema_version", "gippa_version", "git_commit", "git_dirty", "command_line", "executor",
    "profile", "resume", "outdir", "started_at", "finished_at", "status", "exit_code",
    "failed_step", "failed_log", "publication", "config", "inputs", "inputs_absent", "tools",
    "databases", "annotation", "operon_source", "operon_source_reason", "detection_tier",
    "seeds", "steps", "skipped", "modules_off",
    "flags", "layers_missing", "warnings", "volatile", "provenance_digest", "sensitivity",
    "context", "operons", "mapping", "novel_orfs", "calibration"
  ],
  "$defs": {
    "nstr": {"type": ["string", "null"]},
    "strs": {"type": "array", "items": {"type": "string"}},
    "nnum": {"type": ["number", "null"]},
    "nint": {"type": ["integer", "null"]}
  },
  "properties": {
    "schema_version": {"type": "string", "description": "The config format (Q-L13)."},
    "output_schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "description": "MAJOR.MINOR of the tables and the manifest (gippa.schemas.OUTPUT_SCHEMA_VERSION; M11-14h)."},
    "gippa_version": {"type": "string"},
    "git_commit": {"$ref": "#/$defs/nstr"},
    "git_dirty": {"type": ["boolean", "null"]},
    "command_line": {"$ref": "#/$defs/strs"},
    "executor": {"enum": ["local", "nextflow"]},
    "profile": {"$ref": "#/$defs/nstr"},
    "launch": {
      "description": "How gippa run chose the Nextflow profile (M11-15a): flag or auto-detected; null for the local executor.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["profile", "profile_source", "profile_reason"],
      "properties": {
        "profile": {"type": "string"},
        "profile_source": {"enum": ["auto", "flag"]},
        "profile_reason": {"type": "string"}
      }
    },
    "resume": {"type": "boolean"},
    "outdir": {"type": "string"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "status": {"enum": ["completed", "failed"]},
    "exit_code": {"type": "integer", "minimum": 0},
    "failed_step": {"$ref": "#/$defs/nstr"},
    "failed_log": {"$ref": "#/$defs/nstr"},
    "publication": {"type": "boolean"},
    "demo": {"type": "boolean", "description": "true for a 'gippa demo' run (M11-15 item 2); absent otherwise."},
    "config": {"type": "object", "description": "The resolved configuration (config.schema.json)."},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "file", "path", "sha256", "size"],
        "properties": {
          "role": {"type": "string"},
          "file": {"type": "string", "pattern": "^[^/]+$"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "inputs_absent": {"$ref": "#/$defs/strs"},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "container_digest", "conda_lock_hash", "processes"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": "string"},
          "container_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "conda_lock_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "processes": {"$ref": "#/$defs/strs"},
          "local_build": {"const": true, "description": "UniOP built by setup --uniop (M11-14 item 1b)."},
          "runtime": {"enum": ["docker", "apptainer", "micromamba", "prebuilt"]},
          "source_sha256": {"type": ["string", "null"], "pattern": "^(sha256:)?[0-9a-f]{64}$"}
        }
      }
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "checksum", "retrieved", "size_bytes"],
        "properties": {
          "name": {"type": "string"},
          "version": {"$ref": "#/$defs/nstr"},
          "checksum": {"$ref": "#/$defs/nstr"},
          "retrieved": {"$ref": "#/$defs/nstr"},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "annotation": {
      "type": ["object", "null"],
      "additionalProperties": {"$ref": "#/$defs/nstr"},
      "required": ["source", "bakta_version", "db_version", "db_type"]
    },
    "operon_source": {
      "description": "Source of the operon pairs and TUs, from operon_meta.json (M11-14d); null when operon_pairs did not run.",
      "enum": ["uniop", "distance_model", "precomputed", null]
    },
    "operon_source_reason": {"$ref": "#/$defs/nstr"},
    "detection_tier": {"$ref": "#/$defs/nstr"},
    "seeds": {"type": "object", "required": ["master"], "additionalProperties": {"type": "integer"}},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "n_tasks", "n_retries"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["completed", "cached", "failed"]},
          "n_tasks": {"type": "integer", "minimum": 0},
          "n_retries": {"type": "integer", "minimum": 0},
          "wall_time_s": {"type": "number", "minimum": 0},
          "cpu_time_s": {"type": "number", "minimum": 0},
          "peak_rss_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": {"type": "string"},
          "reason": {"pattern": "^(module_off:[a-z_]+|opt_in_off|precomputed:[a-z0-9_]+|not_run)$"}
        }
      }
    },
    "modules_off": {"type": "array", "items": {"enum": ["bgc", "function", "mobile"]}},
    "flags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+(:[a-z0-9_.-]+)?$"}},
    "layers_missing": {"$ref": "#/$defs/strs"},
    "warnings": {"$ref": "#/$defs/strs"},
    "volatile": {"$ref": "#/$defs/strs"},
    "provenance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "n_rows", "families"],
      "properties": {
        "level": {"enum": ["off", "basic", "full"]},
        "n_rows": {"type": "integer", "minimum": 0},
        "families": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["n_primary", "n_variant", "n_shared", "jaccard"],
              "properties": {
                "n_primary": {"$ref": "#/$defs/nint"},
                "n_variant": {"$ref": "#/$defs/nint"},
                "n_shared": {"$ref": "#/$defs/nint"},
                "jaccard": {"$ref": "#/$defs/nnum"}
              }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicons", "oric"],
      "properties": {
        "replicons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contig", "scanned", "block_rule", "l_hat", "block_len", "morans_i_lag1",
                         "flags"],
            "properties": {
              "contig": {"type": "string"},
              "scanned": {"type": "boolean"},
              "block_rule": {"type": "string"},
              "l_hat": {"$ref": "#/$defs/nint"},
              "block_len": {"$ref": "#/$defs/nint"},
              "morans_i_lag1": {"$ref": "#/$defs/nnum"},
              "flags": {"$ref": "#/$defs/strs"}
            }
          }
        },
        "oric": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["contig", "midpoints", "spread", "accepted", "oric"],
            "properties": {
              "contig": {"type": "string"},
              "midpoints": {"type": "array", "items": {"type": "number"}},
              "spread": {"type": "number", "minimum": 0},
              "accepted": {"type": "boolean"},
              "oric": {"$ref": "#/$defs/nnum"}
            }
          }
        }
      }
    },
    "operons": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["pi0", "bin_counts"],
      "properties": {
        "pi0": {"$ref": "#/$defs/nnum"},
        "bin_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bin", "lower_bp", "upper_bp"],
            "properties": {
              "bin": {"type": "integer", "minimum": 0},
              "lower_bp": {"$ref": "#/$defs/nnum"},
              "upper_bp": {"$ref": "#/$defs/nnum"}
            },
            "additionalProperties": {"$ref": "#/$defs/nnum"}
          }
        }
      }
    },
    "mapping": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["search_db", "n_queries"],
      "properties": {
        "search_db": {"$ref": "#/$defs/nstr"},
        "n_queries": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "novel_orfs": {
      "description": "M7-11b: the novel_orfs.class_fdr event data (one per class list) sorted by (regime, class); null without one.",
      "type": ["object", "null"], "additionalProperties": false, "required": ["classes"],
      "properties": {"classes": {"type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["regime", "class", "estimated", "reason", "n_targets", "n_target_wins", "n_decoys",
                     "paired_share", "c", "q_floor", "floor_above_alpha", "alpha", "n_called"],
        "properties": {
          "regime": {"enum": ["picked_decoy", "denovo_subgroup"]}, "class": {"type": "string"},
          "estimated": {"type": "boolean"}, "reason": {"$ref": "#/$defs/nstr"},
          "n_targets": {"type": "integer", "minimum": 0}, "n_target_wins": {"$ref": "#/$defs/nint"},
          "n_decoys": {"type": "integer", "minimum": 0}, "paired_share": {"$ref": "#/$defs/nnum"},
          "c": {"$ref": "#/$defs/nnum"}, "q_floor": {"$ref": "#/$defs/nnum"},
          "floor_above_alpha": {"type": "boolean"}, "alpha": {"type": "number"},
          "n_called": {"type": "integer", "minimum": 0}
        }}}}
    },
    "calibration": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["calibrated", "provenance"],
        "properties": {
          "calibrated": {"type": "boolean"},
          "provenance": {"$ref": "#/$defs/nstr"}
        }
      }
    }
  }
}
