{
  "name": "gippa-run",
  "title": "GIPPA run outputs",
  "description": "Frictionless Data Package of GIPPA's tables; each resource names its schema (GIPPA_SPEC.md §9.5). A plot_support resource path may resolve to the same path with .gz appended (a support table over 1 MB is written gzipped, ADR-0043; read it as compression gz); null_regions in its percentile-grid form follows plot_support/null_regions_grid.json.",
  "profile": "tabular-data-package",
  "output_schema_version": "1.1",
  "resources": [
    {"name": "pileup", "profile": "tabular-data-resource", "path": "tables/pileup.tsv.gz", "format": "tsv", "compression": "gz", "encoding": "utf-8", "coordinates": "1-based-closed", "schema": "tables/pileup.schema.json"},
    {"name": "variants", "profile": "tabular-data-resource", "path": "tables/variants.tsv", "format": "tsv", "encoding": "utf-8", "coordinates": "1-based-closed", "schema": "tables/variants.schema.json"},
    {"name": "novel_orfs", "profile": "tabular-data-resource", "path": "tables/novel_orfs.tsv", "format": "tsv", "encoding": "utf-8", "coordinates": "1-based-closed", "schema": "tables/novel_orfs.schema.json"},
    {"name": "replicon_landmarks", "role": "plot_support", "profile": "tabular-data-resource", "path": "plots/support/replicon_landmarks.tsv", "format": "tsv", "encoding": "utf-8", "coordinates": "1-based-closed", "schema": "plot_support/replicon_landmarks.json"},
    {"name": "gc_skew", "role": "plot_support", "profile": "tabular-data-resource", "path": "plots/support/gc_skew.tsv", "format": "tsv", "encoding": "utf-8", "coordinates": "1-based-closed", "schema": "plot_support/gc_skew.json"},
    {"name": "variant_windows", "role": "plot_support", "profile": "tabular-data-resource", "path": "plots/support/variant_windows.tsv", "format": "tsv", "encoding": "utf-8", "coordinates": "1-based-closed", "schema": "plot_support/variant_windows.json"},
    {"name": "gsea_running", "role": "plot_support", "profile": "tabular-data-resource", "path": "plots/support/gsea_running.tsv", "format": "tsv", "encoding": "utf-8", "schema": "plot_support/gsea_running.json"},
    {"name": "determinants_shap", "role": "plot_support", "profile": "tabular-data-resource", "path": "plots/support/determinants_shap.tsv", "format": "tsv", "encoding": "utf-8", "schema": "plot_support/determinants_shap.json"},
    {"name": "determinants_pd", "role": "plot_support", "profile": "tabular-data-resource", "path": "plots/support/determinants_pd.tsv", "format": "tsv", "encoding": "utf-8", "schema": "plot_support/determinants_pd.json"},
    {"name": "null_regions", "role": "plot_support", "profile": "tabular-data-resource", "path": "plots/support/null_regions.tsv", "format": "tsv", "encoding": "utf-8", "schema": "plot_support/null_regions.json"},
    {"name": "null_islands", "role": "plot_support", "profile": "tabular-data-resource", "path": "plots/support/null_islands.tsv", "format": "tsv", "encoding": "utf-8", "schema": "plot_support/null_islands.json"},
    {"name": "null_determinants", "role": "plot_support", "profile": "tabular-data-resource", "path": "plots/support/null_determinants.tsv", "format": "tsv", "encoding": "utf-8", "schema": "plot_support/null_determinants.json"}
  ]
}
