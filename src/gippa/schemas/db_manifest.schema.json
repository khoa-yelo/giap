{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khoa-yelo/gippa/schemas/db_manifest.schema.json",
  "title": "GIPPA database manifest (DIR/db_manifest.json, gippa setup)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "url", "checksum", "size_bytes", "retrieved", "path",
                     "status", "message"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string"},
          "url": {"type": "string"},
          "checksum": {"type": "string", "pattern": "^(md5:[0-9a-f]{32}|sha256:[0-9a-f]{64})?$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "retrieved": {"type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"},
          "path": {"type": "string"},
          "status": {"enum": ["ok", "absent", "mismatch"]},
          "message": {"type": "string"},
          "local_build": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runtime", "ref", "digest", "key", "terms"],
            "properties": {
              "runtime": {"enum": ["docker", "apptainer", "micromamba", "prebuilt"]},
              "ref": {"type": "string"},
              "digest": {"type": "string"},
              "key": {"type": "string"},
              "terms": {"enum": ["flag", "prompt", ""]}
            }
          }
        }
      }
    }
  }
}
