// FarmShare Slurm (GIAP_SPEC.md §3.8, §6.3; R14: job names start with giap-).
// R14: at most queueSize x resourceLimits.cpus = 8 x 16 = 128 CPUs run concurrently.
// FarmShare enforces MaxMemPerCPU = 4000 MB, so a task asks for max(label cpus, ceil(memory / 4 GB))
// CPUs; task.memory is already clamped by resourceLimits, so this holds after the memory x 2 retry.
// User --threads/--memory (params.threads/params.memory) and these limits combine as the minimum.
// Larger-memory steps get their own bigmem label with maxForks 1 when they appear (M2-07+).
process {
    executor       = 'slurm'
    queue          = 'normal'
    clusterOptions = '--qos=normal'
    scratch        = '/tmp'
    resourceLimits = [
        cpus:   Math.min(16, params.threads as int),
        memory: [64.GB, params.memory as nextflow.util.MemoryUnit].min(),
        time:   48.h,
    ]
    cpus = { Math.max(1, Math.ceil(task.memory.toBytes() / 4.GB.toBytes()) as int) }

    withLabel: 'process_single' { cpus = { Math.max(1,  Math.ceil(task.memory.toBytes() / 4.GB.toBytes()) as int) } }
    withLabel: 'process_low'    { cpus = { Math.max(2,  Math.ceil(task.memory.toBytes() / 4.GB.toBytes()) as int) } }
    withLabel: 'process_medium' { cpus = { Math.max(8,  Math.ceil(task.memory.toBytes() / 4.GB.toBytes()) as int) } }
    withLabel: 'process_high'   { cpus = { Math.max(16, Math.ceil(task.memory.toBytes() / 4.GB.toBytes()) as int) } }
}
executor {
    queueSize       = 8
    submitRateLimit = '10/1min'
    jobName         = { "giap-" + task.process.tokenize(':')[-1].toLowerCase() }
}

includeConfig 'prebuilt_envs.config'
