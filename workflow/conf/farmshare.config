// FarmShare Slurm (GIAP_SPEC.md §3.8, §6.3; R14: job names start with giap-).
// R14: at most queueSize x resourceLimits.cpus = 8 x 16 = 128 CPUs run concurrently.
// FarmShare enforces MaxMemPerCPU = 4000 MB, so a task asks for max(label cpus, ceil(memory / 4000 MB))
// CPUs; task.memory is already clamped by resourceLimits, so this holds after the memory x 2 retry.
// Not yet at the 64 GB cap: 17 derived CPUs are clamped to resourceLimits.cpus 16 (backlog N3).
// User --threads/--memory (params.threads/params.memory) and these limits combine as the minimum.
// Larger-memory steps get their own bigmem label with maxForks 1 when they appear (M2-07+).
// Multi-CPU tools ask for 12 h x attempt: without a time request a task gets the partition default
// (2 h on normal), and TerminatorNet on K-12 with --threads 6 needs ~3 h (M7-15 real-tool arm).
// process_single/low ask for 2 h x attempt, so a 143 (time) retry asks for more (lead decision 11).
process {
    executor       = 'slurm'
    queue          = 'normal'
    // Slow/failing nodes excluded as a stopgap (#416 D3: barley-01 hit time limits, exit 140).
    clusterOptions = '--qos=normal --exclude=barley-01,rye-02'
    scratch        = '/tmp'
    resourceLimits = [
        cpus:   Math.min(16, params.threads as int),
        memory: [64.GB, params.memory as nextflow.util.MemoryUnit].min(),
        time:   48.h,
    ]
    cpus = { Math.max(1, Math.ceil(task.memory.toBytes() / 4000.MB.toBytes()) as int) }

    withLabel: 'process_single' { cpus = { Math.max(1,  Math.ceil(task.memory.toBytes() / 4000.MB.toBytes()) as int) }; time = { 2.h * task.attempt } }
    withLabel: 'process_low'    { cpus = { Math.max(2,  Math.ceil(task.memory.toBytes() / 4000.MB.toBytes()) as int) }; time = { 2.h * task.attempt } }
    withLabel: 'process_medium' { cpus = { Math.max(8,  Math.ceil(task.memory.toBytes() / 4000.MB.toBytes()) as int) }; time = { 12.h * task.attempt } }
    withLabel: 'process_high'   { cpus = { Math.max(16, Math.ceil(task.memory.toBytes() / 4000.MB.toBytes()) as int) }; time = { 12.h * task.attempt } }
    // base.config's withName CPUs outrank the labels: keep max(cpus, ceil(memory / 4000 MB)) (ADR-0062).
    withName: 'PROMOTECH|PROMOTECH_NOVEL' { cpus = { Math.max(2, Math.ceil(task.memory.toBytes() / 4000.MB.toBytes()) as int) } }
    withName: 'ANTISMASH' { cpus = { Math.max(4, Math.ceil(task.memory.toBytes() / 4000.MB.toBytes()) as int) } }
}
executor {
    queueSize       = 8
    submitRateLimit = '10/1min'
    jobName         = { "giap-" + task.process.tokenize(':')[-1].toLowerCase() }
}

includeConfig 'prebuilt_envs.config'
