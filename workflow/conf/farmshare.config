// FarmShare Slurm (GIAP_SPEC.md §3.8, §6.3; R14: job names start with giap-).
process {
    executor       = 'slurm'
    queue          = 'normal'
    clusterOptions = '--qos=normal'
    scratch        = '/tmp'
    resourceLimits = [cpus: 64, memory: 240.GB, time: 48.h]
}
executor {
    queueSize       = 20
    submitRateLimit = '10/1min'
    jobName         = { "giap-" + task.process.tokenize(':')[-1].toLowerCase() }
}
