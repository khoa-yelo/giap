// FarmShare (farmshare, farmshare_local): the conda-only tools run in the prebuilt micromamba envs
// under $GIPPA_ROOT (scripts/build_envs.sh; M2-07 review decisions 4, 12), never a fresh build from the
// module's yml. The pinned-container tools get conda off in the apptainer profile.
conda {
    enabled       = true
    useMicromamba = true
}
process {
    withName: 'UNIOP'               { conda = "${System.getenv('GIPPA_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/gippa-uniop" }
    withName: 'PROMOTECH'           { conda = "${System.getenv('GIPPA_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/gippa-promotech" }
    withName: 'PROMOTER_CALCULATOR' { conda = "${System.getenv('GIPPA_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/gippa-promoter_calculator" }
    withName: 'TERMINATORNET.*'     { conda = "${System.getenv('GIPPA_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/gippa-terminatornet" }
    withName: 'OSTIR'               { conda = "${System.getenv('GIPPA_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/gippa-ostir" }
    withName: 'BACTERMFINDER'       { conda = "${System.getenv('GIPPA_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/gippa-bactermfinder" }
}
// The function step starts R fgsea itself (gippa.io.fgsea_r, ADR-0038), conda-only under every
// profile (M8-17 lead decision 9): the step reads the prefix from GIPPA_FGSEA_PREFIX.
env {
    GIPPA_FGSEA_PREFIX = "${System.getenv('GIPPA_ROOT') ?: projectDir.toString() + '/../local'}/micromamba/envs/gippa-fgsea"
}
