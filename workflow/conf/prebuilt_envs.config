// FarmShare (farmshare, farmshare_local): the conda-only tools run in the prebuilt micromamba envs
// under $GIAP_ROOT (scripts/build_envs.sh; M2-07 review decisions 4, 12), never a fresh build from the
// module's yml. The pinned-container tools get conda off in the apptainer profile.
conda {
    enabled       = true
    useMicromamba = true
}
process {
    withName: 'UNIOP'               { conda = "${System.getenv('GIAP_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/giap-uniop" }
    withName: 'PROMOTECH'           { conda = "${System.getenv('GIAP_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/giap-promotech" }
    withName: 'PROMOTER_CALCULATOR' { conda = "${System.getenv('GIAP_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/giap-promoter_calculator" }
    withName: 'TERMINATORNET'       { conda = "${System.getenv('GIAP_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/giap-terminatornet" }
    withName: 'OSTIR'               { conda = "${System.getenv('GIAP_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/giap-ostir" }
    withName: 'BACTERMFINDER'       { conda = "${System.getenv('GIAP_ROOT') ?: "${projectDir}/../local"}/micromamba/envs/giap-bactermfinder" }
}
// The function step starts R fgsea itself (giap.io.fgsea_r, ADR-0038), conda-only under every
// profile (M8-17 lead decision 9): the step reads the prefix from GIAP_FGSEA_PREFIX.
env {
    GIAP_FGSEA_PREFIX = "${System.getenv('GIAP_ROOT') ?: projectDir.toString() + '/../local'}/micromamba/envs/giap-fgsea"
}
