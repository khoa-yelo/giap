// Local executor inside the session allocation: SLURM_CPUS_ON_NODE CPUs (else 4, with a warning), 30 GB.
// (println returns null, so the Elvis chain warns and then falls back to '4'.)
process {
    executor       = 'local'
    resourceLimits = [
        cpus: (System.getenv('SLURM_CPUS_ON_NODE')
            ?: System.err.println('WARN: SLURM_CPUS_ON_NODE is not set; farmshare_local uses 4 CPUs')
            ?: '4').toInteger(),
        memory: 30.GB,
    ]
}
