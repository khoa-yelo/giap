// Local executor inside the session allocation (GIAP_SPEC.md §3.8): parallel tasks share the
// allocation, not the host. executor.cpus = SLURM_CPUS_PER_TASK (else 4, with a warning);
// executor.memory = SLURM_MEM_PER_NODE (MB) - 2 GB (else 30 GB). User --threads/--memory and the
// allocation combine as the minimum in resourceLimits.
// (println returns null, so the Elvis chain warns and then falls back to '4'; Nextflow 26's config
// parser rejects `if` and variable declarations.)
process {
    executor       = 'local'
    resourceLimits = [
        cpus:   Math.min((System.getenv('SLURM_CPUS_PER_TASK') ?: '4').toInteger(), params.threads as int),
        memory: [
            "${(System.getenv('SLURM_MEM_PER_NODE') ?: '32768').toLong() - 2048} MB" as nextflow.util.MemoryUnit,
            params.memory as nextflow.util.MemoryUnit,
        ].min(),
    ]
}
executor {
    cpus = (System.getenv('SLURM_CPUS_PER_TASK')
        ?: System.err.println('WARN: SLURM_CPUS_PER_TASK is not set; farmshare_local uses 4 CPUs')
        ?: '4').toInteger()
    memory = "${(System.getenv('SLURM_MEM_PER_NODE') ?: '32768').toLong() - 2048} MB"
}
