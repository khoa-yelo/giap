// Settings shared by the container profiles (`apptainer` and `docker`) of workflow/nextflow.config,
// written once so the two cannot drift (M11-14 item 3b). Included by those two profiles only: under
// `-profile conda` alone every tool keeps its conda env (M11-14 item 3).
process {
    // Per-task temp dir inside the (mounted) task work dir, so a host TMPDIR outside the container
    // binds never leaks into a container (M2-07 decision 5a). The beforeScript runs on the host:
    // Apptainer passes the environment through, the docker profile adds TMPDIR to envWhitelist.
    // No module sets its own beforeScript.
    beforeScript = 'mkdir -p tmp; export TMPDIR=$PWD/tmp'
    // Pinned-container tools (workflow/conf/containers.config) never use conda, even where conda is
    // on for the conda-only tools (`-profile docker,conda`, the farmshare profiles). This is the one
    // selector scripts/release/update_digests.py --nextflow-config edits (M11-06 item 4).
    withName: 'BAKTA|TRANSTERMHP|GENOMAD|ANTISMASH|MINIPROT|BLAST|TBLASTN|PROMOTECH|PROMOTECH_NOVEL|PROMOTER_CALCULATOR|TERMINATORNET|TERMINATORNET_PLAN|TERMINATORNET_CHUNK|TERMINATORNET_MERGE|BACTERMFINDER|OSTIR|OSTIR_NOVEL' { conda = '' }
}
