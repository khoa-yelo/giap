// Process labels, resource limits and the error strategy (GIAP_SPEC.md §6.3).
// Retry at most twice on 137/143 (killed: memory or time); memory (and time where set) grow with
// task.attempt, clamped by the profile's resourceLimits. A retry must change the request (M7-15
// lead decision 11): 137 retries only while task.memory is below the memory cap; 143 also retries
// while a set time is below the time cap. Otherwise, and on any other exit, the task terminates.
// No withName/withLabel entry or module overrides errorStrategy or maxRetries.

process {
    cpus           = 1
    memory         = { 2.GB * task.attempt }
    // One line: `nextflow config -flat` prints the closure's source, which the policy test reads.
    errorStrategy  = { task.exitStatus in [137, 143] && (task.resourceLimits?.memory == null || task.memory < (task.resourceLimits.memory as nextflow.util.MemoryUnit) || (task.exitStatus == 143 && task.time != null && (task.resourceLimits?.time == null || task.time < (task.resourceLimits.time as nextflow.util.Duration)))) ? 'retry' : 'terminate' }
    maxRetries     = 2
    resourceLimits = [cpus: params.threads, memory: params.memory]

    withLabel: 'process_single' { cpus = 1;  memory = { 2.GB * task.attempt } }
    withLabel: 'process_low'    { cpus = 2;  memory = { 6.GB * task.attempt } }
    withLabel: 'process_medium' { cpus = 8;  memory = { 16.GB * task.attempt } }
    withLabel: 'process_high'   { cpus = 16; memory = { 48.GB * task.attempt } }

    // process_high for the determinants step (M8-10 lead decision 2): the permutation null runs
    // on the task's CPUs. GIAP_STEP is process_single, so this matches its DETERMINANTS alias only.
    withName: 'DETERMINANTS:DETERMINANTS_STEP' { cpus = 16; memory = { 48.GB * task.attempt } }

    // TerminatorNet (perf, ADR-0062): its window scan is a -n task.cpus multiprocessing pool and
    // the genome-wide run is the critical path of real runs (65-120 min at 8 CPUs, ~94 % CPU
    // efficiency); its output does not depend on -n (pool.map in window order). The process_high
    // CPUs at the process_medium memory (3.2 GB peak on a 5-Mb genome); resourceLimits clamp it.
    withName: 'TERMINATORNET' { cpus = 16; memory = { 16.GB * task.attempt } }
    // Promotech RF-HOT predicts on one core (99 % CPU at 8 requested; 7.4 GB peak): 2 CPUs and
    // 10 GB (3 CPUs under FarmShare's 4 GB per CPU), so the 8-CPU chunks no longer wait in the
    // queue (mean 9.5 min, max 118 min) or hold the queueSize slots.
    withName: 'PROMOTECH|PROMOTECH_NOVEL' { cpus = 2; memory = { 10.GB * task.attempt } }

    // Tool options from the resolved config (params.json), never hard-coded in modules.
    withName: 'MINIPROT' { ext.args = { params.mapping?.proteins?.miniprot_args ?: '' } }
    withName: 'TBLASTN'  { ext.args = { params.mapping?.proteins?.tblastn_args ?: '' } }

    // R fgsea runs inside the function step: ~4 GB for R plus the Python step; two calls of at
    // most 1 h each (M8-17 §9).
    withName: 'FUNCTION_STEP' { cpus = 1; memory = { 6.GB * task.attempt }; time = { 4.h * task.attempt } }
    // The sensitivity step reruns R fgsea and the determinants LightGBM CV: sized like
    // FUNCTION_STEP with the process_low CPUs (M8-16 lead decision 5).
    withName: 'SENSITIVITY_RERUNS:SENSITIVITY' { cpus = 2; memory = { 6.GB * task.attempt }; time = { 4.h * task.attempt } }
    // GIAP_STEP aliases cannot take a label; REPORT_HTML gets the process_low resources (M9-02).
    withName: 'REPORT_HTML' { cpus = 2; memory = { 6.GB * task.attempt } }
    // The codon pileup holds every aligned hit: 3.8 GB peak on K-12 with 151k peptides (M7-15).
    withName: 'VARIANTS_STEP' { memory = { 8.GB * task.attempt } }
}
