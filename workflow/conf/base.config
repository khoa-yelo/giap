// Process labels, resource limits and the error strategy (GIAP_SPEC.md §6.3).
// Retry twice on 137/143 (killed: memory or time), memory x 2 then x 3 (task.attempt); any other
// exit terminates. No withName entry overrides errorStrategy or maxRetries.

process {
    cpus           = 1
    memory         = { 2.GB * task.attempt }
    errorStrategy  = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries     = 2
    resourceLimits = [cpus: params.threads, memory: params.memory]

    withLabel: 'process_single' { cpus = 1;  memory = { 2.GB * task.attempt } }
    withLabel: 'process_low'    { cpus = 2;  memory = { 6.GB * task.attempt } }
    withLabel: 'process_medium' { cpus = 8;  memory = { 16.GB * task.attempt } }
    withLabel: 'process_high'   { cpus = 16; memory = { 48.GB * task.attempt } }

    // process_high for the determinants step (M8-10 lead decision 2): the permutation null runs
    // on the task's CPUs. GIAP_STEP is process_single, so this matches its DETERMINANTS alias only.
    withName: 'DETERMINANTS:DETERMINANTS_STEP' { cpus = 16; memory = { 48.GB * task.attempt } }

    // Tool options from the resolved config (params.json), never hard-coded in modules.
    withName: 'MINIPROT' { ext.args = { params.mapping?.proteins?.miniprot_args ?: '' } }
    withName: 'TBLASTN'  { ext.args = { params.mapping?.proteins?.tblastn_args ?: '' } }

    // R fgsea runs inside the function step: ~4 GB for R plus the Python step; two calls of at
    // most 1 h each (M8-17 §9).
    withName: 'FUNCTION_STEP' { cpus = 1; memory = { 6.GB * task.attempt }; time = 4.h }
    // GIAP_STEP aliases cannot take a label; REPORT_HTML gets the process_low resources (M9-02).
    withName: 'REPORT_HTML' { cpus = 2; memory = { 6.GB * task.attempt } }
    // The codon pileup holds every aligned hit: 3.8 GB peak on K-12 with 151k peptides (M7-15).
    withName: 'VARIANTS_STEP' { memory = { 8.GB * task.attempt } }
}
