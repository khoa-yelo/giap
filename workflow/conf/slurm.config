// A generic Slurm cluster (spec M11-15 item 3): the cluster's default partition, no site-specific
// options. `gippa run` writes the params.slurm_* below into OUT/work/params.json (null when unset;
// the flags that set them arrive with M11-15e). Job names start with gippa- (R14 naming).
process {
    executor       = 'slurm'
    queue          = params.slurm_queue ?: null
    clusterOptions = [params.slurm_options, params.slurm_account ? "--account=${params.slurm_account}" : null].findAll().join(' ')
    resourceLimits = [
        cpus:   params.threads as int,
        memory: params.memory as nextflow.util.MemoryUnit,
        time:   (params.slurm_max_time ?: '48h') as nextflow.util.Duration,
    ]
}
executor {
    queueSize       = (params.slurm_max_jobs ?: 20) as int
    submitRateLimit = '10/1min'
    jobName         = { "gippa-" + task.process.tokenize(':')[-1].toLowerCase() }
}
