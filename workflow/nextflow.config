// GIPPA workflow configuration (GIPPA_SPEC.md §6.3). Nextflow never parses user parameters:
// `gippa run` writes every params.* below into OUT/work/params.json (runner/nextflow.py).
// Defaults mirror gippa/config/defaults.yaml and the `gippa run` CLI defaults.

params {
    threads    = 16
    memory     = '64 GB'
    outdir     = 'results'
    modules    = ['core', 'mobile', 'bgc', 'function']
    annotation = null   // resolved annotation section, written by gippa run
    config     = null
    inputs     = null   // absolute input paths, written by gippa run
    mapping    = null   // resolved mapping section, written by gippa run
    db_dir     = null   // database directory (gippa setup); else $GIPPA_DB_DIR
    run_uniop  = true   // false: UNIOP is skipped, operons use the distance model (annotation.uniop.enabled, M11-14d)
    stub       = [windows_chunks: 1, tu_regions: 1]   // stub runs only: scattered file counts
    // Slurm executor settings read by the `slurm` profile (M11-15 item 3); null = the profile's own
    slurm_queue    = null
    slurm_account  = null
    slurm_options  = null
    slurm_max_jobs = null
    slurm_max_time = null
}

// Trace columns read by gippa.runner.nextflow.failed_step (workdir; hash is the fallback).
trace {
    fields = 'task_id,hash,native_id,name,tag,status,exit,attempt,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir,hostname,container'
    overwrite = true   // a rerun (--resume) into the same OUT replaces OUT/logs/trace.tsv
}
timeline.overwrite = true
report.overwrite   = true

// Every task, under every profile: Python tool envs must not import ~/.local packages (a user-site
// ViennaRNA 2.7.1 shadowed the env's pinned 2.6.4 in OSTIR runs).
env {
    PYTHONNOUSERSITE = '1'
}

includeConfig 'conf/base.config'
includeConfig 'conf/containers.config'

profiles {
    standard        { includeConfig 'conf/standard.config' }
    test            { includeConfig 'conf/test.config' }
    stub            { conda.enabled = false }
    farmshare       { includeConfig 'conf/farmshare.config' }
    farmshare_local { includeConfig 'conf/farmshare_local.config' }
    slurm           { includeConfig 'conf/slurm.config' }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        // NXF_APPTAINER_CACHEDIR wins; else $GIPPA_ROOT/containers (large files only under $GIPPA_ROOT, R14)
        apptainer.cacheDir   = System.getenv('NXF_APPTAINER_CACHEDIR') ?: System.getenv('GIPPA_ROOT')?.concat('/containers')
        // The database directory (params.db_dir, written by gippa run) is bound read-only (#78 review 3b).
        apptainer.runOptions = params.db_dir ? "-B ${params.db_dir}:${params.db_dir}:ro" : ''
        // Per-task TMPDIR and the pinned-process conda-off selector, shared with `docker`.
        includeConfig 'conf/container_common.config'
        // The bakta and antiSMASH images have no `ps`, which Nextflow's task metrics need (and which
        // cannot be disabled per process): bind the /proc-based assets/ps/ps read-only (M2-07 decisions 3, 13).
        process {
            withName: 'BAKTA|ANTISMASH' { containerOptions = "-B ${projectDir}/assets/ps/ps:/usr/bin/ps:ro" }
        }
    }
    conda {
        conda.enabled       = true
        conda.useMicromamba = true
    }
    docker {
        docker.enabled      = true
        // The database directory (params.db_dir) read-only, as under apptainer; tasks run as the
        // calling user, so outputs are not root-owned (M11-14 item 3b).
        docker.runOptions   = (params.db_dir ? "-v ${params.db_dir}:${params.db_dir}:ro " : '') + '-u $(id -u):$(id -g)'
        // Docker does not inherit the host environment: pass the beforeScript's per-task TMPDIR
        // and the env scope's PYTHONNOUSERSITE in.
        docker.envWhitelist = 'TMPDIR,PYTHONNOUSERSITE'
        // Per-task TMPDIR and the pinned-process conda-off selector, shared with `apptainer`.
        includeConfig 'conf/container_common.config'
        // The ps shim for the bakta and antiSMASH images, as under apptainer (M2-07 decision 13).
        process {
            withName: 'BAKTA|ANTISMASH' { containerOptions = "-v ${projectDir}/assets/ps/ps:/usr/bin/ps:ro" }
        }
    }
}
