// GIAP workflow configuration (GIAP_SPEC.md §6.3). Nextflow never parses user parameters:
// `giap run` writes every params.* below into OUT/work/params.json (runner/nextflow.py).
// Defaults mirror giap/config/defaults.yaml and the `giap run` CLI defaults.

params {
    threads    = 16
    memory     = '64 GB'
    outdir     = 'results'
    modules    = ['core', 'mobile', 'bgc', 'function']
    annotation = null   // resolved annotation section, written by giap run
    config     = null
    inputs     = null   // absolute input paths, written by giap run
    mapping    = null   // resolved mapping section, written by giap run
    db_dir     = null   // database directory (giap setup); else $GIAP_DB_DIR
    stub       = [windows_chunks: 1, tu_regions: 1]   // stub runs only: scattered file counts
}

// Trace columns read by giap.runner.nextflow.failed_step (workdir; hash is the fallback).
trace {
    fields = 'task_id,hash,native_id,name,tag,status,exit,attempt,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir,hostname,container'
    overwrite = true   // a rerun (--resume) into the same OUT replaces OUT/logs/trace.tsv
}
timeline.overwrite = true
report.overwrite   = true

includeConfig 'conf/base.config'
includeConfig 'conf/containers.config'

profiles {
    standard        { includeConfig 'conf/standard.config' }
    test            { includeConfig 'conf/test.config' }
    stub            { conda.enabled = false }
    farmshare       { includeConfig 'conf/farmshare.config' }
    farmshare_local { includeConfig 'conf/farmshare_local.config' }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        // NXF_APPTAINER_CACHEDIR wins; else $GIAP_ROOT/containers (large files only under $GIAP_ROOT, R14)
        apptainer.cacheDir   = System.getenv('NXF_APPTAINER_CACHEDIR') ?: System.getenv('GIAP_ROOT')?.concat('/containers')
        // The database directory (params.db_dir, written by giap run) is bound read-only (#78 review 3b).
        apptainer.runOptions = params.db_dir ? "-B ${params.db_dir}:${params.db_dir}:ro" : ''
        // Pinned-container tools never use conda, even where conda is on for the conda-only tools.
        // The bakta and antiSMASH images have no `ps`, which Nextflow's task metrics need (and which
        // cannot be disabled per process): bind the /proc-based assets/ps/ps read-only (M2-07 decisions 3, 13).
        process {
            // Per-task temp dir inside the (auto-mounted) task work dir, so a host TMPDIR outside the
            // container binds never leaks into a container (M2-07 decision 5a). No module sets its own
            // beforeScript; the ps shim below is a bind (containerOptions), so nothing to merge.
            beforeScript = 'mkdir -p tmp; export TMPDIR=$PWD/tmp'
            withName: 'BAKTA|TRANSTERMHP|GENOMAD|ANTISMASH|MINIPROT|BLAST|TBLASTN' { conda = '' }
            withName: 'BAKTA|ANTISMASH' { containerOptions = "-B ${projectDir}/assets/ps/ps:/usr/bin/ps:ro" }
        }
    }
    conda {
        conda.enabled       = true
        conda.useMicromamba = true
    }
    docker {
        docker.enabled = true
    }
}
