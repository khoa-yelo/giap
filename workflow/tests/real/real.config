// Config for the real-tool entry workflows in this directory (scripts/slurm/nf_process_real.sbatch):
// the pipeline config plus publishing of each process's declared outputs into <launchDir>/out.
// assets/ links ../../assets: the apptainer profile binds ${projectDir}/assets/ps/ps.
includeConfig '../../nextflow.config'
process.publishDir = [path: 'out', mode: 'copy', saveAs: { f -> f == 'versions.yml' ? null : f }]
