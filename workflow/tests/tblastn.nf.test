    test("M11-16d db_gencode parity default-25: ('-seg no -evalue 1e-5', 25)") {

        when {
            params {
                fake_bin = "${moduleTestDir}/bin"
                mapping = [proteins: [tblastn_args: "-seg no -evalue 1e-5"]]
