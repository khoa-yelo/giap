    test("M11-16d db_gencode parity middle-same: ('-evalue 1e-3 -db_gencode 4 -seg no', 4)") {

        when {
            params {
                fake_bin = "${moduleTestDir}/bin"
                mapping = [proteins: [tblastn_args: "-evalue 1e-3 -db_gencode 4 -seg no"]]
