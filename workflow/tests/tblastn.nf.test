                """
            }
        }

        then {
            assert process.success
            def line = new File(path(process.out.hits[0]).parent.toFile(), "blast.argv").readLines()[1]
            def got = line.replaceFirst(/^tblastn -db db\/genome -query proteins\.faa -num_threads \d+ /, '').replaceFirst(/ -outfmt 6 .*$/, '')
            assert got == "-evalue 1e-3 -db_gencode 4"
        }
    }

    test("M11-16d db_gencode parity equals-form-same: ('-db_gencode=4 -evalue 1e-3', 4)") {

        when {
            params {
                fake_bin = "${moduleTestDir}/bin"
                mapping = [proteins: [tblastn_args: "-db_gencode=4 -evalue 1e-3"]]
