    test("M11-16d db_gencode parity extra-option-25: ('-seg no -evalue 1e-5 -max_target_seqs 5', 25)") {

        when {
            params {
                fake_bin = "${moduleTestDir}/bin"
                mapping = [proteins: [tblastn_args: "-seg no -evalue 1e-5 -max_target_seqs 5"]]
