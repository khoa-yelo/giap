                """
            }
        }

        then {
            assert process.success
            def line = new File(path(process.out.hits[0]).parent.toFile(), "blast.argv").readLines()[1]
            def got = line.replaceFirst(/^tblastn -db db\/genome -query proteins\.faa -num_threads \d+ /, '').replaceFirst(/ -outfmt 6 .*$/, '')
