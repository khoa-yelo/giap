// Config for workflow/tests/annotate_tools.nf.test: the pipeline config, a 2-CPU cap for the local
// executor and the fake bakta / promoter-calculator (workflow/tests/bin) first on PATH.
includeConfig '../nextflow.config'

params.threads  = 2
params.fake_bin = null

process {
    beforeScript = { params.fake_bin ? "export PATH=${params.fake_bin}:\$PATH" : '' }
}
