// Module contract for workflow/tests/miniprot.nf.test: MINIPROT takes its alignment options from
// task.ext.args (set directly here, bypassing the pipeline's mapping.proteins.miniprot_args wiring).
includeConfig 'miniprot.config'

process {
    withName: 'MINIPROT' { ext.args = '--outs=0.42 -N 1' }
}
