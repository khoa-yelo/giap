// Config for workflow/tests/*_support.nf.test: the pipeline config and, for the non-stub tests,
// the fake gippa (workflow/tests/bin_gippa) first on PATH; params.fake_support = true makes it
// write each *_support output (see bin_gippa/gippa), false leaves the support path unwritten.
includeConfig '../nextflow.config'

params.fake_bin     = null
params.fake_support = false

process {
    beforeScript = { params.fake_bin ? "export PATH=${params.fake_bin}:\$PATH FAKE_GIPPA_SUPPORT=${params.fake_support ? 1 : 0}" : '' }
}
