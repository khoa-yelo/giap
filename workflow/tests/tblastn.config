// Config for workflow/tests/tblastn.nf.test: the pipeline config, a 2-CPU cap for the local
// executor and the fake makeblastdb/tblastn (workflow/tests/bin) first on PATH for non-stub tests.
includeConfig '../nextflow.config'

params.threads  = 2
params.fake_bin = null

process {
    beforeScript = { params.fake_bin ? "export PATH=${params.fake_bin}:\$PATH" : '' }
}
