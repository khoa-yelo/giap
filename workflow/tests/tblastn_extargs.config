// Module contract for workflow/tests/tblastn.nf.test: TBLASTN takes its search options from
// task.ext.args (set directly here, bypassing the pipeline's mapping.proteins.tblastn_args wiring).
includeConfig 'tblastn.config'

process {
    withName: 'TBLASTN' { ext.args = '-db_gencode 4 -evalue 1e-3' }
}
