// Config for workflow/tests/miniprot.nf.test: the pipeline config, a 2-CPU cap for the local
// executor and the fake miniprot (workflow/tests/bin) first on PATH for the non-stub tests.
includeConfig '../nextflow.config'

params.threads  = 2
params.fake_bin = null

process {
    beforeScript = { params.fake_bin ? "export PATH=${params.fake_bin}:\$PATH" : '' }
}
