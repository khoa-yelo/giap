// Container pins for the apptainer/docker profiles (GIPPA_SPEC.md §3.1, §6.3; ADR-0008).
// Digests only: every image is <image>@sha256:<digest> with no scheme; Nextflow adds docker://
// for Apptainer (ADR-0059). Re-resolve a tag with
//   python scripts/resolve_digest.py <image:tag>
// and update this file in a PR (containers.yml does this for GHCR images, §12).
//
// Conda-only for now (no upstream image; lead decision 1, M2-01 Q3): these processes keep their
// per-process `conda` env (workflow/envs/<tool>.yml) even under -profile apptainer until
// containers.yml publishes ghcr.io/<owner>/gippa-<tool> from workflow/containers/<tool>/:
//   uniop, promotech, promoter_calculator, terminatornet, bactermfinder, ostir
// fgsea is conda-only under every profile (M8-17 lead decision 9): the function step starts
// workflow/bin/gippa_fgsea.R in the gippa-fgsea env itself; the image pin is deferred.
//
// SIF sizes in GiB for the gippa setup plan (measured 2026-10-27 on FarmShare, apptainer 1.4.4):
//   sif_gib antismash=4.6 bakta=0.43 blast=0.22 genomad=0.73 miniprot=0.01 transtermhp=0.01
//
// Tags the digests were resolved from (2026-10-14):
//   oschwengers/bakta:v1.12.2
//   quay.io/biocontainers/transtermhp:2.09--h9948957_2
//   quay.io/biocontainers/genomad:1.12.0--pyhdfd78af_0
//   antismash/standalone:8.0.4
//   quay.io/biocontainers/miniprot:0.18--h577a1d6_0
//   quay.io/biocontainers/blast:2.16.0--h66d330f_5

process {
  withName: 'BAKTA' { container = 'oschwengers/bakta@sha256:1e24ae2f435c46f876a322298ab96d994d15aadc2824e1f16a77fa9a1bc07f18' }
  withName: 'TRANSTERMHP' { container = 'quay.io/biocontainers/transtermhp@sha256:fc6fe0404be9340a883ec7a7b90415dfc3826c2bca7333a0314335c7bfee2d03' }
  withName: 'GENOMAD' { container = 'quay.io/biocontainers/genomad@sha256:d54652ff868af72604ea0e54c541c5c92168c7ac821a422de05dcbad65509e5c' }
  withName: 'ANTISMASH' { container = 'antismash/standalone@sha256:d3f390e687cfe02f1387be40256dddbf678e91bc56b96c36da07b56ec8bda29d' }
  withName: 'MINIPROT' { container = 'quay.io/biocontainers/miniprot@sha256:2eb53fea53743b56b1c10ac4b202469b92db959ffbb8bafd83156fdbde80e22f' }
  withName: 'BLAST' { container = 'quay.io/biocontainers/blast@sha256:9dfc69f990c0aeb936276ee591ed32919a79f46dfa34060055e05a050a17959c' }
  withName: 'TBLASTN' { container = 'quay.io/biocontainers/blast@sha256:9dfc69f990c0aeb936276ee591ed32919a79f46dfa34060055e05a050a17959c' }
}
