# Install with: scrontab scripts/slurm/nightly.scrontab   (view: scrontab -l; remove: scrontab -r)
# Every night at 01:30 Pacific: the nightly job array (scripts/slurm/nightly.sbatch, M2-21) on the
# latest origin/main: 0 integration + contract + nf-test, 1 benchmarks (wheat), 2 calibration_nightly,
# 3 real giap run on sim100k. Proposed for Khoa (M2-21); the installed line keeps the same script.
#SCRON --job-name=giap-nightly
#SCRON --partition=normal
#SCRON --qos=normal
#SCRON --array=0-3
#SCRON --cpus-per-task=16
#SCRON --mem=60G
#SCRON --time=06:00:00
#SCRON --output=/home/classes/bios/270/khoa/giap/local/logs/giap-nightly.%A_%a.out
30 1 * * * /home/classes/bios/270/khoa/giap/scripts/slurm/nightly.sbatch
